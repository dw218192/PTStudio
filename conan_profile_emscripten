# Conan profile for Emscripten/WASM cross-builds
[settings]
os=Emscripten
arch=wasm
build_type=Release
compiler=emcc
compiler.version=4.0.10
compiler.cppstd=17
compiler.libcxx=libc++

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:exelinkflags=['-sALLOW_MEMORY_GROWTH=1', '-sMAXIMUM_MEMORY=4GB', '-sINITIAL_MEMORY=64MB']
tools.build:sharedlinkflags=['-sALLOW_MEMORY_GROWTH=1', '-sMAXIMUM_MEMORY=4GB', '-sINITIAL_MEMORY=64MB']
tools.build:compiler_executables={"c":"emcc","cpp":"em++","ar":"emar","ranlib":"emranlib","nm":"emnm","strip":"emstrip"}

[buildenv]
CC=emcc
CXX=em++
AR=emar
NM=emnm
RANLIB=emranlib
STRIP=emstrip

[tool_requires]
*: emsdk/3.1.73