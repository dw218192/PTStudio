    # ── Lights ──

    def DistantLight "KeyLight"
    {
        float inputs:intensity = 1.5
        color3f inputs:color = (1, 0.95, 0.9)
        float inputs:angle = 1.0
        float3 xformOp:rotateXYZ = (-45, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DomeLight "FillLight"
    {
        float inputs:intensity = 0.3
        color3f inputs:color = (0.8, 0.85, 1)
    }

    def Camera "TopDown"
    {
        token projection = "orthographic"
        float horizontalAperture = 200
        float verticalAperture = 150
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 20, 0)
        float3 xformOp:rotateXYZ = (-90, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
