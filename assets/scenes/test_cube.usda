#usda 1.0
(
    defaultPrim = "Root"
    upAxis = "Y"
)

def Xform "Root"
{
    def Cube "Cube"
    {
        double size = 2
    }

    def DistantLight "DefaultLight"
    {
        float inputs:intensity = 1.0
        color3f inputs:color = (1.0, 0.95, 0.9)
        float3 xformOp:rotateXYZ = (-45.0, 30.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
}
