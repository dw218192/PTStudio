#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1.0
    upAxis = "Y"
)

def Xform "Root"
{
    def Scope "Materials"
    {
        def Material "Glass"
        {
            token outputs:surface.connect = </Root/Materials/Glass/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1.0, 1.0, 1.0)
                float inputs:opacity = 0.0
                float inputs:metallic = 0
                float inputs:roughness = 0
                float inputs:ior = 1.5
                token outputs:surface
            }
        }

        def Material "TintedGlass"
        {
            token outputs:surface.connect = </Root/Materials/TintedGlass/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.8, 0.5)
                float inputs:opacity = 0.0
                float inputs:metallic = 0
                float inputs:roughness = 0
                float inputs:ior = 1.5
                token outputs:surface
            }
        }

        def Material "RedMatte"
        {
            token outputs:surface.connect = </Root/Materials/RedMatte/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.15, 0.15)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                float inputs:ior = 1.5
                token outputs:surface
            }
        }

        def Material "GroundPlane"
        {
            token outputs:surface.connect = </Root/Materials/GroundPlane/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.6, 0.6)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                float inputs:ior = 1.5
                token outputs:surface
            }
        }
    }

    def Sphere "GlassSphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1
        double3 xformOp:translate = (0, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Root/Materials/Glass>
    }

    def Sphere "TintedGlassSphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.7
        double3 xformOp:translate = (2.5, 0.7, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Root/Materials/TintedGlass>
    }

    def Sphere "RedSphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.5
        double3 xformOp:translate = (-2, 0.5, 1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Root/Materials/RedMatte>
    }

    def Cube "Ground" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 20
        double3 xformOp:translate = (0, -10, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Root/Materials/GroundPlane>
    }

    def DomeLight "DomeLight"
    {
        color3f inputs:color = (1, 1, 1)
        float inputs:intensity = 1
    }

    def SphereLight "KeyLight"
    {
        float inputs:intensity = 2.0
        double3 xformOp:translate = (3, 5, 3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
