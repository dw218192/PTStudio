#usda 1.0
(
    defaultPrim = "Root"
    upAxis = "Y"
)

def Xform "Root"
{
    def Scope "Materials"
    {
        def Material "White"
        {
            token outputs:surface.connect = </Root/Materials/White/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

    def Sphere "Sphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1
        rel material:binding = </Root/Materials/White>
    }

    # Rect light above-left, angled down toward the sphere.
    # Default emission is -Z; rotate to aim at origin.
    def RectLight "AreaLight"
    {
        float inputs:intensity = 3
        color3f inputs:color = (1, 1, 1)
        float inputs:width = 2
        float inputs:height = 2
        double3 xformOp:translate = (-2, 3, 2)
        float3 xformOp:rotateXYZ = (-50, -30, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
