#!/bin/bash

set -e

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$ROOT/_tools/venv"
BOOTSTRAP="$ROOT/tools/bootstrap.sh"

# Detect Python path based on platform (Windows uses Scripts, Unix uses bin)
if [[ -f "$VENV/Scripts/python.exe" ]]; then
    VENV_PY="$VENV/Scripts/python.exe"
elif [[ -f "$VENV/bin/python" ]]; then
    VENV_PY="$VENV/bin/python"
else
    VENV_PY=""
fi

# Check if bootstrapping is needed by checking if the venv Python exists
if [[ ! -f "$VENV_PY" ]]; then
    echo "Bootstrapping repository tooling..."
    bash "$BOOTSTRAP"
    if [[ $? -ne 0 ]]; then
        echo "Bootstrap failed!"
        exit 1
    fi
    # Re-detect after bootstrap
    if [[ -f "$VENV/Scripts/python.exe" ]]; then
        VENV_PY="$VENV/Scripts/python.exe"
    elif [[ -f "$VENV/bin/python" ]]; then
        VENV_PY="$VENV/bin/python"
    fi
fi

# Invoke the Python package module (subshell keeps cd local)
(cd "$ROOT/tools" && exec "$VENV_PY" -m repo_tools "$@")
